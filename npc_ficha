  window._pokeDex=dex;
}

// ─── Autocomplete UI ──────────────────────────────────
let _acActive={};
function criarAutoComplete(inputId,prefix,slotIndex){
  const input=document.getElementById(inputId);
  if(!input||input.dataset.acBound) return;
  input.dataset.acBound='1';
  input.setAttribute('autocomplete','off');
  if(!input.parentElement.classList.contains('pk-ac-wrap')){
    const wrap=document.createElement('div');wrap.className='pk-ac-wrap';
    input.parentNode.insertBefore(wrap,input);wrap.appendChild(input);
  }
  const listId=`ac-list-${inputId}`;
  let list=document.getElementById(listId);
  if(!list){list=document.createElement('div');list.className='pk-ac-list';list.id=listId;list.style.display='none';input.parentElement.appendChild(list);}
  function fechar(){list.style.display='none';_acActive[inputId]=-1;}
  function selecionar(item){
    input.value=item.nome;fechar();
    const t0=document.getElementById(`${prefix}-tipo0-${slotIndex}`);
    const t1=document.getElementById(`${prefix}-tipo1-${slotIndex}`);
    if(t0&&!t0.value&&item.tipos[0]) t0.value=item.tipos[0].toLowerCase();
    if(t1&&item.tipos[1]) t1.value=item.tipos[1].toLowerCase();
    const fileInput=document.getElementById(`${prefix}-img-file-${slotIndex}`);
    const hasManualUpload=fileInput&&fileInput.dataset.hasUpload==='1';
    if(!hasManualUpload){
      const prev=document.getElementById(`${prefix}-img-prev-${slotIndex}`);
      if(prev&&item.sprite){prev.src=item.sprite;prev.style.display='block';}
      if(!window._pokeImgs) window._pokeImgs={};
      if(!window._pokeImgs.time) window._pokeImgs.time={};
      window._pokeImgs.time[slotIndex]=item.sprite;
    }
  }
  function renderLista(q){
    const query=q.toLowerCase().trim();
    if(!query){fechar();return;}
    const matches=window._pokeDex.filter(p=>p.nome.toLowerCase().includes(query)).slice(0,20);
    if(!matches.length){fechar();return;}
    _acActive[inputId]=0;
    list.innerHTML=matches.map((p,idx)=>`<div class="pk-ac-item${idx===0?' active':''}" data-idx="${idx}"><img src="${p.sprite}" onerror="this.src='${FALLBACK}'"/><span>${p.nome}</span></div>`).join('');
    list.style.display='block';
    list.querySelectorAll('.pk-ac-item').forEach(el=>{
      el.addEventListener('mousedown',ev=>{ev.preventDefault();selecionar(matches[parseInt(el.dataset.idx)]);});
    });
  }
  input.addEventListener('input',()=>renderLista(input.value));
  input.addEventListener('focus',()=>{if(input.value) renderLista(input.value);});
  input.addEventListener('blur',()=>setTimeout(fechar,150));
  input.addEventListener('keydown',e=>{
    if(list.style.display==='none') return;
    const items=list.querySelectorAll('.pk-ac-item');
    let cur=_acActive[inputId]||0;
    if(e.key==='ArrowDown'){e.preventDefault();cur=Math.min(cur+1,items.length-1);}
    else if(e.key==='ArrowUp'){e.preventDefault();cur=Math.max(cur-1,0);}
    else if(e.key==='Enter'||e.key==='Tab'){if(items[cur]){e.preventDefault();items[cur].dispatchEvent(new MouseEvent('mousedown'));}return;}
    else if(e.key==='Escape'){fechar();return;}
    _acActive[inputId]=cur;
    items.forEach((el,i)=>el.classList.toggle('active',i===cur));
    items[cur]?.scrollIntoView({block:'nearest'});
  });
}


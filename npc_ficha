<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Ficha de NPC — Kingdom Platinum</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --accent:#1a1a1a;
  --bg:#f4f6fa;--surface:#ffffff;--surface2:#f0f0f0;
  --text:#1a1f2e;--muted:#666666;--border:#d0d0d0;
  --font-title:'Cinzel',serif;--font-body:'Nunito',sans-serif;
}
html,body{min-height:100%;background:var(--bg);font-family:var(--font-body);color:var(--text)}
/* LOADING */
.loading-overlay{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}
.loading-spinner{width:36px;height:36px;border:3px solid #ccc;border-top-color:#e53e3e;border-radius:50%;animation:spin .7s linear infinite}
.loading-text{font-size:14px;color:var(--muted);font-weight:600}
@keyframes spin{to{transform:rotate(360deg)}}
/* TOP BAR */
.top-bar{background:var(--cor-cabecalho,#1a1a1a);padding:8px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:100}
.top-bar-title{font-family:var(--font-title);font-size:14px;color:#fff;font-weight:700;display:flex;align-items:center;gap:10px}
.top-bar-title a{color:rgba(255,255,255,.65);text-decoration:none;font-size:12px;font-family:var(--font-body);font-weight:600}
.top-bar-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{padding:8px 18px;border-radius:3px;border:none;font-family:var(--font-body);font-size:12px;font-weight:700;cursor:pointer;transition:opacity .15s}
.btn:hover{opacity:.85}
.btn-primary{background:var(--accent);color:#fff}
.btn-danger{background:#fee2e2;color:#c00;border:1px solid #fca5a5}
.btn-sm{padding:5px 12px;font-size:11px}
/* FICHA WRAP */
.ficha-wrap{max-width:1000px;margin:0 auto;padding:16px 12px 60px}
/* CABEÇALHO */
.ficha-header{background:var(--bg);margin-bottom:1px}
.header-name-row{background:var(--cor-cabecalho,#1a1a1a);padding:7px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.ficha-title{font-family:var(--font-title);font-size:18px;font-weight:700;color:#fff;letter-spacing:1px;text-transform:uppercase}
.cat-badge{font-size:11px;font-weight:700;color:#fff;font-family:var(--font-body);white-space:nowrap;background:rgba(255,255,255,.15);padding:4px 12px;border-radius:20px;text-transform:uppercase;letter-spacing:.4px}
.header-slogan-row{background:var(--cor-slogan,#3a3a3a);padding:5px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.ficha-slogan{font-size:10px;font-style:normal;color:#fff;font-family:var(--font-body)}
.header-body{display:grid;grid-template-columns:1fr 220px;height:264px;border-top:2px solid var(--bg)}
.header-banner-col{overflow:hidden;display:flex;align-items:center;justify-content:center;background:#2a2a2a;position:relative}
.header-banner-col img{width:100%;height:100%;object-fit:cover;display:block}
.header-banner-placeholder{font-size:12px;color:#888;font-family:var(--font-body);text-align:center;padding:20px;pointer-events:none}
.header-banner-edit-btn{position:absolute;bottom:8px;right:10px;background:rgba(0,0,0,.65);color:#fff;border:none;border-radius:3px;font-size:10px;font-family:var(--font-body);padding:4px 10px;cursor:pointer;opacity:0;transition:opacity .2s}
.header-banner-col:hover .header-banner-edit-btn{opacity:1}
.header-photo-col{border-left:2px solid var(--bg);overflow:hidden;display:flex;align-items:center;justify-content:center;background:#ddd;position:relative}
.header-photo-col img{width:220px;height:100%;object-fit:cover;display:block}
.header-photo-placeholder{font-size:11px;color:#aaa;font-family:var(--font-body);text-align:center;padding:10px}
.header-photo-edit-btn{position:absolute;bottom:8px;right:10px;background:rgba(0,0,0,.65);color:#fff;border:none;border-radius:3px;font-size:10px;font-family:var(--font-body);padding:4px 10px;cursor:pointer;opacity:0;transition:opacity .2s}
.header-photo-col:hover .header-photo-edit-btn{opacity:1}
/* DADOS GRID */
.dados-grid-wrap{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto auto;margin-bottom:1px}
.dado-header{background:var(--cor-dados,#1a1a1a);padding:5px 8px;text-align:center;font-size:11px;font-weight:700;color:#fff;font-family:var(--font-body);border-right:1.5px solid var(--bg)}
.dado-header:last-child{border-right:none}
.dado-val{background:var(--surface);padding:5px 8px;text-align:center;font-size:13px;font-family:var(--font-body);border-right:1.5px solid var(--bg);border-bottom:1.5px solid var(--bg)}
.dado-val:last-child{border-right:none}
.dados-grid-wrap .dado-header{border-bottom:1px solid var(--bg)}
.dados-grid-wrap .dado-val{border-bottom:1.5px solid var(--bg)}
/* SECTION */
.ficha-section{margin-bottom:4px}
.ficha-section-title{background:var(--cor-secao,#1a1a1a);padding:8px 12px;text-align:center;font-family:var(--font-title);font-size:14px;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:center;gap:6px;position:relative}
.modo-edicao .ficha-section-title{cursor:pointer;user-select:none}
.ficha-section-body{background:var(--surface);border:1.5px solid var(--bg);padding:12px;overflow:hidden;transition:max-height .3s ease,padding .3s ease}
.ficha-section.fechada .ficha-section-body{max-height:0!important;padding-top:0!important;padding-bottom:0!important;border-width:0!important}
.ficha-section.oculta{display:none}
/* TIME */
.time-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:0}
.poke-slot{background:var(--surface);border:1px solid var(--bg);display:flex;flex-direction:column;min-height:220px}
.poke-slot-topbar{background:var(--cor-poke,#1a1a1a);padding:4px 6px;display:flex;align-items:center;justify-content:space-between;gap:4px}
.poke-slot-ball{width:19px;height:19px;object-fit:contain;flex-shrink:0}
.poke-slot-tipos{display:flex;gap:3px;align-items:center}
.poke-slot-tipo-img{width:34px;height:17px;object-fit:contain}
.poke-slot-img-wrap{background:#f5f5f5;display:flex;align-items:center;justify-content:center;height:100px;overflow:hidden;border-bottom:1px solid var(--bg)}
.poke-slot-img-wrap img{width:100px;height:100px;object-fit:contain;image-rendering:pixelated}
.poke-slot-nome-row{background:var(--cor-poke,#1a1a1a);padding:3px 6px;text-align:center}
.poke-slot-nome-lbl{font-size:13px;font-weight:700;color:#fff;font-family:var(--font-title);text-transform:uppercase;letter-spacing:.4px}
.poke-slot-info{font-size:12px;color:var(--text);line-height:1.7;font-family:var(--font-body);padding:5px 6px;flex:1}
.poke-slot-info strong{font-weight:700;color:var(--cor-poke,#1a1a1a)}
.poke-slot-edit{border:1.5px solid var(--accent);padding:6px;display:flex;flex-direction:column;gap:4px;background:var(--surface)}
.poke-slot-edit label{font-size:9px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;margin-top:2px}
.poke-slot-edit input,.poke-slot-edit textarea,.poke-slot-edit select{width:100%;padding:3px 6px;border:1px solid #ccc;border-radius:2px;font-size:10px;font-family:var(--font-body);resize:vertical;outline:none;background:#fff}
.poke-slot-edit input:focus,.poke-slot-edit textarea:focus,.poke-slot-edit select:focus{border-color:var(--accent)}
.poke-slot-edit-img-preview{width:40px;height:40px;object-fit:contain;image-rendering:pixelated;border:1px solid #eee;border-radius:2px;display:block;margin:2px auto}
.poke-slot-edit-img-btn{width:100%;padding:3px;border:1px dashed #ccc;border-radius:2px;background:#fafafa;font-size:10px;font-family:var(--font-body);cursor:pointer;text-align:center;color:var(--muted)}
/* AUTOCOMPLETE POKÉMON */
.pk-ac-wrap{position:relative;width:100%}
.pk-ac-list{position:absolute;top:100%;left:0;right:0;background:#fff;border:1.5px solid var(--accent);border-top:none;border-radius:0 0 4px 4px;max-height:160px;overflow-y:auto;z-index:500;box-shadow:0 4px 12px rgba(0,0,0,.15)}
.pk-ac-item{display:flex;align-items:center;gap:6px;padding:4px 7px;cursor:pointer;font-size:11px;font-family:var(--font-body);transition:background .1s}
.pk-ac-item:hover,.pk-ac-item.active{background:#f0f4ff}
.pk-ac-item img{width:40px;height:40px;object-fit:contain;flex-shrink:0}
.pk-ac-item span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* RELACIONADOS */
.rel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0}
.rel-item{background:var(--cor-rel,#000);padding:5px 8px;text-align:center;border:1px solid var(--bg)}
.rel-nome{font-size:11px;font-weight:700;color:#fff;font-family:var(--font-body)}
.rel-tipo{font-size:10px;color:#fff;font-family:var(--font-body)}
/* TEXTO */
.bio-text{font-size:12px;color:var(--text);line-height:1.8;white-space:pre-wrap;font-family:var(--font-body);text-align:justify;text-indent:28px}
/* EDIT */
.edit-bar{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:2px solid var(--accent);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:100;flex-wrap:wrap}
.edit-bar-info{font-size:12px;color:var(--muted);font-family:var(--font-body)}
.edit-bar-info strong{color:var(--accent)}
.edit-input{width:100%;padding:6px 10px;border:1.5px solid #ccc;border-radius:3px;font-family:var(--font-body);font-size:12px;color:var(--text);background:var(--surface);outline:none;resize:vertical}
.edit-input:focus{border-color:var(--accent)}
.edit-input-sm{height:32px;resize:none}
.view-content{display:block}
.edit-content{display:none}
/* MODAIS GENÉRICOS */
.cores-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px}
.cores-modal{background:#fff;border-radius:4px;padding:24px;width:100%;max-width:360px;box-shadow:0 8px 32px rgba(0,0,0,.3)}
.cores-modal-title{font-family:var(--font-title);font-size:15px;font-weight:700;color:#1a1a1a;margin-bottom:16px;text-align:center}
.cores-row{display:flex;flex-direction:column;gap:12px;margin-bottom:18px}
.cores-field{display:flex;align-items:center;justify-content:space-between;gap:12px}
.cores-field label{font-size:11px;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.4px;font-family:var(--font-body)}
.cores-field input[type=color]{width:44px;height:32px;border:1.5px solid #ccc;border-radius:3px;padding:2px;cursor:pointer;background:none}
.cores-modal-btns{display:flex;gap:8px;justify-content:flex-end}
.modal-field{margin-bottom:14px;text-align:left}
.modal-field label{display:block;font-size:11px;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px;font-family:var(--font-body)}
.modal-field input,.modal-field select{width:100%;padding:8px 10px;border:1.5px solid #ccc;border-radius:3px;font-family:var(--font-body);font-size:13px;outline:none}
.fb-err{background:#fee2e2;color:#c00;border:1px solid #fca5a5;border-radius:3px;padding:8px 12px;font-size:12px;font-weight:600;margin-top:10px;display:none}
@media(max-width:600px){
  .ficha-wrap{padding:10px 8px 60px}
  .header-body{grid-template-columns:1fr;grid-template-rows:200px;height:auto}
  .header-photo-col{display:none}
  .header-banner-col{height:200px}
  .header-banner-edit-btn{opacity:1}
  .dados-grid-wrap{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:none}
  .time-grid{grid-template-columns:repeat(2,1fr)}
  .dado-header{font-size:9px;padding:4px 8px}
  .dado-val{font-size:11px;padding:5px 8px}
  .ficha-title{font-size:15px}
  .ficha-section-title{font-size:12px;padding:7px 10px}
  .ficha-section-body{padding:10px}
  .bio-text{font-size:11px}
  .rel-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<div class="loading-overlay" id="loading-overlay">
  <div class="loading-spinner"></div>
  <div class="loading-text" id="loading-text">Abrindo ficha do NPC...</div>
</div>

<div class="top-bar" id="top-bar" style="display:none">
  <div class="top-bar-title"><a href="/npcdex">← NPCdex</a> <span id="tb-nome-sep" style="opacity:.5">/</span> <span id="tb-nome"></span></div>
  <div class="top-bar-actions" id="top-bar-actions"></div>
</div>

<div id="ficha-wrap" class="ficha-wrap" style="display:none">

  <div class="ficha-header">
    <div class="header-name-row">
      <div class="ficha-title" id="f-nome"></div>
      <span class="cat-badge" id="f-cat-badge"></span>
    </div>
    <div class="header-slogan-row">
      <span class="view-content ficha-slogan" id="f-slogan-txt"></span>
      <span class="edit-content" id="f-slogan-edit" style="display:none;flex:1"><input class="edit-input edit-input-sm" id="f-slogan-input" placeholder="Slogan / frase de efeito do NPC..." style="width:100%"/></span>
    </div>
    <div class="header-body">
      <div class="header-banner-col" id="header-banner-col">
        <div id="f-banner-view"><div id="f-banner-placeholder" class="header-banner-placeholder">Sem banner — clique para adicionar</div></div>
        <button class="header-banner-edit-btn" id="btn-banner-edit" onclick="document.getElementById('banner-file-input').click()" style="display:none">🖼 Trocar banner</button>
        <input type="file" id="banner-file-input" accept="image/*" style="display:none" onchange="onImgFile(this,'banner')"/>
      </div>
      <div class="header-photo-col" id="header-photo-col">
        <div id="f-photo-placeholder" class="header-photo-placeholder">Sem foto</div>
        <button class="header-photo-edit-btn" id="btn-photo-edit" onclick="document.getElementById('photo-file-input').click()" style="display:none">📷 Trocar foto</button>
        <input type="file" id="photo-file-input" accept="image/*" style="display:none" onchange="onImgFile(this,'foto')"/>
      </div>
    </div>
  </div>

  <div class="dados-grid-wrap">
    <div class="dado-header">Categoria</div>
    <div class="dado-header">Cargo</div>
    <div class="dado-header">Localização</div>
    <div class="dado-header">Especialidade</div>
    <div class="dado-val">
      <div id="f-categoria-view" class="view-content"><span id="f-categoria-txt">—</span></div>
      <div id="f-categoria-edit" class="edit-content" style="display:none">
        <select class="edit-input edit-input-sm" id="f-categoria-input">
          <option value="gymleader">Líder de Ginásio</option>
          <option value="elitefour">Elite Four</option>
          <option value="liga">Campeão / Liga</option>
          <option value="vilao">Vilão</option>
          <option value="aliado">Aliado</option>
          <option value="comum">NPC Comum</option>
        </select>
      </div>
    </div>
    <div class="dado-val">
      <div id="f-cargo-view" class="view-content"><span id="f-cargo-txt">—</span></div>
      <div id="f-cargo-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-cargo-input" placeholder="Ex: Líder de Ginásio"/></div>
    </div>
    <div class="dado-val">
      <div id="f-local-view" class="view-content"><span id="f-local-txt">—</span></div>
      <div id="f-local-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-local-input" placeholder="Ex: Ginásio de Meridian City"/></div>
    </div>
    <div class="dado-val">
      <div id="f-esp-view" class="view-content"><span id="f-esp-txt">—</span></div>
      <div id="f-esp-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-esp-input" placeholder="Ex: Grama"/></div>
    </div>
  </div>
  <div class="dados-grid-wrap" style="margin-bottom:8px">
    <div class="dado-header">Idade</div>
    <div class="dado-header">Ocupação</div>
    <div class="dado-header">Origem</div>
    <div class="dado-header">Nível</div>
    <div class="dado-val">
      <div id="f-idade-view" class="view-content"><span id="f-idade-txt">—</span></div>
      <div id="f-idade-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-idade-input" placeholder="Ex: 32"/></div>
    </div>
    <div class="dado-val">
      <div id="f-ocup-view" class="view-content"><span id="f-ocup-txt">—</span></div>
      <div id="f-ocup-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-ocup-input" placeholder="Ex: Treinador / Comerciante"/></div>
    </div>
    <div class="dado-val">
      <div id="f-orig-view" class="view-content"><span id="f-orig-txt">—</span></div>
      <div id="f-orig-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-orig-input" placeholder="Ex: Nendo"/></div>
    </div>
    <div class="dado-val">
      <div id="f-nivel-view" class="view-content"><span id="f-nivel-txt">—</span></div>
      <div id="f-nivel-edit" class="edit-content" style="display:none"><input class="edit-input edit-input-sm" id="f-nivel-input" placeholder="Ex: Nv. 30"/></div>
    </div>
  </div>

  <!-- RELACIONADOS -->
  <div class="ficha-section">
    <div class="ficha-section-title">Relacionados</div>
    <div class="ficha-section-body" style="padding:0">
      <div id="f-rel-view" class="view-content"><div class="rel-grid" id="f-rel-grid"></div></div>
      <div id="f-rel-edit" class="edit-content" style="display:none;padding:12px">
        <div id="rel-edit-grid" style="display:flex;flex-direction:column;gap:8px"></div>
      </div>
    </div>
  </div>

  <!-- BIOGRAFIA -->
  <div class="ficha-section">
    <div class="ficha-section-title">Biografia</div>
    <div class="ficha-section-body">
      <div id="f-bio-view" class="view-content"><div class="bio-text" id="f-bio-txt" style="color:var(--muted)">Nenhuma biografia registrada.</div></div>
      <div id="f-bio-edit" class="edit-content" style="display:none"><textarea class="edit-input" id="f-bio-input" rows="6" placeholder="Escreva a história do NPC..."></textarea></div>
    </div>
  </div>

  <!-- TIME -->
  <div class="ficha-section" id="secao-time">
    <div class="ficha-section-title">Time Principal</div>
    <div class="ficha-section-body" style="padding:0">
      <div class="time-grid" id="time-grid"></div>
    </div>
  </div>

  <!-- ANOTAÇÕES -->
  <div class="ficha-section" style="margin-bottom:80px">
    <div class="ficha-section-title">Anotações e Curiosidades</div>
    <div class="ficha-section-body">
      <div id="f-anot-view" class="view-content"><div class="bio-text" id="f-anot-txt" style="color:var(--muted)">Nenhuma anotação registrada.</div></div>
      <div id="f-anot-edit" class="edit-content" style="display:none"><textarea class="edit-input" id="f-anot-input" rows="4" placeholder="Curiosidades, ganchos de aventura, notas livres..."></textarea></div>
    </div>
  </div>

</div>

<!-- BARRA DE EDIÇÃO -->
<div class="edit-bar" id="edit-bar" style="display:none">
  <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0">
    <div class="edit-bar-info">Editando como <strong>ADM</strong></div>
    <div id="autosave-status" style="font-size:11px;color:var(--muted)"></div>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn btn-sm" style="background:#eee;border:1px solid #ccc" onclick="abrirHistorico()">Histórico</button>
    <button class="btn btn-sm" style="background:#eee;border:1px solid #ccc" onclick="abrirModalCores()">🎨 Cores</button>
    <button class="btn btn-danger btn-sm" onclick="excluirNpc()">🗑 Excluir</button>
    <button class="btn btn-sm" style="background:#eee;border:1px solid #ccc" onclick="cancelarEdicao()">Cancelar</button>
    <button class="btn btn-primary btn-sm" id="btn-salvar" onclick="salvarFicha()">💾 Salvar</button>
  </div>
</div>

<!-- MODAL DE CORES -->
<div class="cores-modal-overlay" id="cores-modal-overlay" style="display:none" onclick="if(event.target===this)fecharModalCores()">
  <div class="cores-modal">
    <div class="cores-modal-title">🎨 Personalizar Cores</div>
    <div class="cores-row">
      <div class="cores-field">
        <label>Cor primária<br/><span style="font-size:9px;color:#888;font-weight:400">Cabeçalho · Dados · Títulos de seção</span></label>
        <div style="display:flex;align-items:center;gap:6px">

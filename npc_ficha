async function carregarPokeDex(){
  if(window._pokeDexLoaded) return;
  window._pokeDexLoaded=true;
  let uwadexList=[];
  try{
    const res=await apiGet('uwadex','select=nome,tipos,sprite&order=nome.asc');
    if(Array.isArray(res)) uwadexList=res.filter(p=>p&&p.nome);
  }catch{}
  const uwadexNomes=new Set(uwadexList.map(p=>p.nome.toLowerCase()));
  let oficiais=[];
  try{
    const r=await fetch('https://pokeapi.co/api/v2/pokemon?limit=1025&offset=0');
    if(r.ok){
      const data=await r.json();
      oficiais=(data.results||[]).map(p=>({
        nome:p.name.split('-').map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' '),
        tipos:[],
        sprite:`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${p.url.split('/').filter(Boolean).pop()}.png`
      }));
    }
  }catch{}
  const dex=[];
  uwadexList.forEach(p=>{
    const tipos=(Array.isArray(p.tipos)?p.tipos:[]).filter(Boolean);
    dex.push({nome:p.nome,tipos,sprite:p.sprite||FALLBACK,source:'uwadex'});
  });

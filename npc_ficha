    ${Array.from({length:total},(_,i)=>`
    <div style="display:flex;gap:8px;align-items:center">
      <input class="edit-input edit-input-sm" style="flex:2" value="${rels[i]?.nome||''}" placeholder="Nome" id="rel-nome-${i}"/>
      <input class="edit-input edit-input-sm" style="flex:1" value="${rels[i]?.tipo||''}" placeholder="Tipo de relação" id="rel-tipo-${i}"/>
    </div>`).join('')}`;
}

// ─── Modo edição ──────────────────────────────────────
function ativarEdicao(){
  modoEdicao=true;
  document.getElementById('edit-bar').style.display='flex';
  document.getElementById('btn-banner-edit').style.display='block';
  document.getElementById('btn-photo-edit').style.display='block';
  document.querySelectorAll('.view-content').forEach(el=>el.style.display='none');
  document.querySelectorAll('.edit-content').forEach(el=>el.style.display='block');
  renderTime();renderRelEdit();
  carregarPokeDex().then(()=>{for(let i=0;i<6;i++) criarAutoComplete(`time-pk-nome-${i}`,'time-pk',i);});
  atualizarTopBar();
  iniciarAutoSave();
  fecharSecoes();
  document.body.classList.add('modo-edicao');
}
function cancelarEdicao(){
  clearTimeout(_autoSaveTimer);setAutoSaveStatus('');
  modoEdicao=false;
  document.getElementById('edit-bar').style.display='none';
  document.getElementById('btn-banner-edit').style.display='none';
  document.getElementById('btn-photo-edit').style.display='none';
  document.querySelectorAll('.view-content').forEach(el=>el.style.display='');
  document.querySelectorAll('.edit-content').forEach(el=>el.style.display='none');
  renderFicha();
  atualizarTopBar();
  abrirSecoes();
  document.body.classList.remove('modo-edicao');
}

// ─── Salvar ───────────────────────────────────────────
async function salvarFicha(silencioso=false){
  const btn=document.getElementById('btn-salvar');
  if(!silencioso){btn.textContent='Salvando...';btn.disabled=true;}
  else setAutoSaveStatus('Salvando...','var(--muted)');
  try{
    function coletarTime(){
      const arr=[];
      for(let i=0;i<6;i++){
        const nome=(document.getElementById(`time-pk-nome-${i}`)?.value||'').trim();
        const ball=document.getElementById(`time-pk-ball-${i}`)?.value||'pokeball';
        const t0=document.getElementById(`time-pk-tipo0-${i}`)?.value||'';
        const t1=document.getElementById(`time-pk-tipo1-${i}`)?.value||'';
        const tipos=[t0,t1].filter(Boolean);
        const img=window._pokeImgs?.time?.[i]||(npc.time?.[i]?.img||'');
        const ability=(document.getElementById(`time-pk-ability-${i}`)?.value||'').trim();
        const level=document.getElementById(`time-pk-level-${i}`)?.value||'';
        const gender=document.getElementById(`time-pk-gender-${i}`)?.value||'';
        const nature=(document.getElementById(`time-pk-nature-${i}`)?.value||'').trim();
        const item=(document.getElementById(`time-pk-item-${i}`)?.value||'').trim();
        const moveset=(document.getElementById(`time-pk-moveset-${i}`)?.value||'').trim();
        arr.push(nome?{nome,ball,tipos,img,level,ability,gender,nature,item,moveset}:{});
      }
      return arr;
    }
    const time=coletarTime();
    window._pokeImgs={};
    const relTotal=npc.rel_total||6;
    const relacionamentos=Array.from({length:relTotal},(_,i)=>({
      nome:(document.getElementById(`rel-nome-${i}`)?.value||'').trim(),
      tipo:(document.getElementById(`rel-tipo-${i}`)?.value||'').trim()
    }));
    const novoNpc={
      categoria:document.getElementById('f-categoria-input').value,
      cargo:document.getElementById('f-cargo-input').value.trim(),
      localizacao:document.getElementById('f-local-input').value.trim(),
      especialidade:document.getElementById('f-esp-input').value.trim(),
      idade:document.getElementById('f-idade-input').value.trim(),
      ocupacao:document.getElementById('f-ocup-input').value.trim(),
      origem:document.getElementById('f-orig-input').value.trim(),
      nivel:document.getElementById('f-nivel-input').value.trim(),
      slogan:document.getElementById('f-slogan-input').value.trim(),
      biografia:document.getElementById('f-bio-input').value.trim(),
      anotacoes:document.getElementById('f-anot-input').value.trim(),
      time,relacionamentos,rel_total:relTotal,
      cores:npc.cores||null,updated_at:new Date().toISOString()
    };
    const camposSimples=['categoria','cargo','localizacao','especialidade','idade','ocupacao','origem','nivel','slogan','biografia','anotacoes'];
    const hist=[];
    const agora=new Date().toISOString();
    camposSimples.forEach(k=>{
      const ant=String(npc[k]??''), nov=String(novoNpc[k]??'');
      if(ant!==nov) hist.push({npc_id:npc.id,npc_nome:npc.nome,editado_por:'ADM',campo:k,valor_anterior:ant,valor_novo:nov,editado_em:agora});
    });
    ['time','relacionamentos'].forEach(k=>{
      if(JSON.stringify(npc[k])!==JSON.stringify(novoNpc[k]))
        hist.push({npc_id:npc.id,npc_nome:npc.nome,editado_por:'ADM',campo:k,valor_anterior:JSON.stringify(npc[k]),valor_novo:JSON.stringify(novoNpc[k]),editado_em:agora});
    });
    await apiPatch('npcs',`id=eq.${npc.id}`,novoNpc);
    if(hist.length>0) await apiPost('npcs_historico',hist).catch(()=>{});
    Object.assign(npc,novoNpc);
    if(silencioso){setAutoSaveStatus('✓ Salvo automaticamente','#1a7a1a');setTimeout(()=>setAutoSaveStatus(''),1500);}
    else{btn.textContent='💾 Salvar';btn.disabled=false;cancelarEdicao();}
  }catch(e){
    console.error('Erro ao salvar:',e);
    if(!silencioso){btn.textContent='💾 Salvar';btn.disabled=false;alert('Erro ao salvar: '+e.message);}
    else setAutoSaveStatus('Erro ao salvar','#c00');
  }
}

async function excluirNpc(){
  if(!confirm(`Tem certeza que quer excluir "${npc.nome}"? Essa ação não pode ser desfeita.`)) return;
  try{
    await apiDel('npcs',`id=eq.${npc.id}`);
    location.href='/npcdex';
  }catch(e){ alert('Erro ao excluir: '+e.message); }
}

// ─── Top bar / Admin ───────────────────────────────────
function atualizarTopBar(){
  const actions=document.getElementById('top-bar-actions');
  if(isAdmin()){
    actions.innerHTML=`
      ${modoEdicao?'':`<span style="font-size:11px;color:#fff;opacity:.8">Modo ADM</span>`}
      ${modoEdicao?'':`<button class="btn btn-sm" style="background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.4)" onclick="abrirHistorico()">Histórico</button>`}
      ${modoEdicao?'':`<button class="btn btn-sm" style="background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.4)" onclick="ativarEdicao()">✏️ Editar</button>`}
      ${modoEdicao?'':`<button class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3)" onclick="sairAdmin()">Sair do ADM</button>`}`;
  } else {
    actions.innerHTML=`<button class="btn btn-sm" style="background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.4)" onclick="abrirModalAdmin()">🔒 Entrar como ADM</button>`;
  }
}
function sairAdmin(){localStorage.removeItem(ADMIN_KEY);cancelarEdicao();atualizarTopBar();}
function abrirModalAdmin(){document.getElementById('admin-senha').value='';document.getElementById('admin-err').style.display='none';document.getElementById('modal-admin').style.display='flex';setTimeout(()=>document.getElementById('admin-senha').focus(),50);}
function fecharModalAdmin(){document.getElementById('modal-admin').style.display='none';}
function confirmarAdmin(){
  const v=document.getElementById('admin-senha').value;
  if(v===ADMIN_PASSWORD){localStorage.setItem(ADMIN_KEY,'1');fecharModalAdmin();atualizarTopBar();}
  else document.getElementById('admin-err').style.display='block';
}

// ─── Cores ────────────────────────────────────────────
const CORES_DEFAULT={primaria:'#1a1a1a',secundaria:'#3a3a3a'};
function aplicarCoresFicha(c){
  const p=c.primaria||CORES_DEFAULT.primaria, s=c.secundaria||CORES_DEFAULT.secundaria;
  document.documentElement.style.setProperty('--cor-cabecalho',p);
  document.documentElement.style.setProperty('--cor-secao',p);
  document.documentElement.style.setProperty('--cor-dados',p);
  document.documentElement.style.setProperty('--cor-slogan',s);
  document.documentElement.style.setProperty('--cor-rel',s);
  document.documentElement.style.setProperty('--cor-poke',s);
}
function abrirModalCores(){
  const c=npc.cores||CORES_DEFAULT;
  const p=(c.primaria||CORES_DEFAULT.primaria).replace('#',''), s=(c.secundaria||CORES_DEFAULT.secundaria).replace('#','');
  document.getElementById('cor-primaria').value=p.toUpperCase();
  document.getElementById('cor-secundaria').value=s.toUpperCase();
  document.getElementById('color-picker-primaria').value='#'+p;
  document.getElementById('color-picker-secundaria').value='#'+s;
  document.getElementById('cores-modal-overlay').style.display='flex';
}
function fecharModalCores(){document.getElementById('cores-modal-overlay').style.display='none';aplicarCoresFicha(npc.cores||CORES_DEFAULT);}
function onPickerInput(tipo){const hex=document.getElementById(`color-picker-${tipo}`).value.replace('#','').toUpperCase();document.getElementById(`cor-${tipo}`).value=hex;previewCores();}
function onHexInput(tipo){const v=document.getElementById(`cor-${tipo}`).value.replace(/[^0-9a-fA-F]/g,'').toUpperCase();document.getElementById(`cor-${tipo}`).value=v;if(v.length===6){document.getElementById(`color-picker-${tipo}`).value='#'+v;previewCores();}}
function previewCores(){const p=document.getElementById('cor-primaria').value;const s=document.getElementById('cor-secundaria').value;aplicarCoresFicha({primaria:p.length===6?'#'+p:CORES_DEFAULT.primaria,secundaria:s.length===6?'#'+s:CORES_DEFAULT.secundaria});}
async function salvarCores(){
  const p=document.getElementById('cor-primaria').value, s=document.getElementById('cor-secundaria').value;
  if(p.length!==6||s.length!==6){alert('Insira cores válidas.');return;}
  const c={primaria:'#'+p,secundaria:'#'+s};
  aplicarCoresFicha(c);npc.cores=c;
  await apiPatch('npcs',`id=eq.${npc.id}`,{cores:c,updated_at:new Date().toISOString()});
  fecharModalCores();
}
function resetarCores(){document.getElementById('cor-primaria').value='1A1A1A';document.getElementById('cor-secundaria').value='3A3A3A';document.getElementById('color-picker-primaria').value=CORES_DEFAULT.primaria;document.getElementById('color-picker-secundaria').value=CORES_DEFAULT.secundaria;previewCores();}

// ─── Histórico ────────────────────────────────────────
async function abrirHistorico(){
  const lista=document.getElementById('hist-lista');
  lista.innerHTML='<div style="padding:12px;color:#888;text-align:center">Carregando...</div>';
  document.getElementById('hist-modal-overlay').style.display='flex';
  const hist=await apiGet('npcs_historico',`npc_id=eq.${npc.id}&order=editado_em.desc&limit=50`);
  if(!hist||hist.length===0){lista.innerHTML='<div style="padding:12px;color:#888;text-align:center">Nenhuma edição registrada.</div>';return;}
  const labels={categoria:'Categoria',cargo:'Cargo',localizacao:'Localização',especialidade:'Especialidade',idade:'Idade',ocupacao:'Ocupação',origem:'Origem',nivel:'Nível',slogan:'Slogan',biografia:'Biografia',anotacoes:'Anotações',time:'Time',relacionamentos:'Relacionados',cores:'Cores'};
  lista.innerHTML=hist.map(h=>{
    const d=new Date(h.editado_em);
    const data=d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
    const campo=labels[h.campo]||h.campo;
    function formatVal(campo,raw){
      if(!raw)return'—';
      if(campo==='time'||campo==='relacionamentos'){try{const arr=JSON.parse(raw);return arr.filter(x=>x&&x.nome).map(x=>x.nome+(x.tipo?` (${x.tipo})`:'')).join(', ')||'(vazio)';}catch{return raw;}}
      if(campo==='cores'){try{const c=JSON.parse(raw);return`primária: ${c.primaria||'—'} · secundária: ${c.secundaria||'—'}`;}catch{return raw;}}
      return raw||'—';
    }
    return`<div class="hist-entry"><div><span class="hist-campo">${campo}</span><span class="hist-data">${data}</span></div><div class="hist-val"><span style="text-decoration:line-through;opacity:.6">${formatVal(h.campo,h.valor_anterior)}</span> → <span>${formatVal(h.campo,h.valor_novo)}</span></div></div>`;
  }).join('');
}
function fecharHistorico(){document.getElementById('hist-modal-overlay').style.display='none';}

// ─── Autosave ─────────────────────────────────────────
let _autoSaveTimer=null;
function setAutoSaveStatus(msg,cor='var(--muted)'){const el=document.getElementById('autosave-status');if(el){el.textContent=msg;el.style.color=cor;}}
function agendarAutoSave(){if(!modoEdicao)return;clearTimeout(_autoSaveTimer);setAutoSaveStatus('Alterações não salvas...','#e8a020');_autoSaveTimer=setTimeout(async()=>{setAutoSaveStatus('Salvando...','var(--muted)');await salvarFicha(true);},600);}
function iniciarAutoSave(){document.getElementById('ficha-wrap').addEventListener('input',agendarAutoSave);document.getElementById('ficha-wrap').addEventListener('change',agendarAutoSave);}

// ── Acordeão das seções (só no modo edição) ────────────
function fecharSecoes(){
  document.querySelectorAll('.ficha-section').forEach(sec=>{
    const body=sec.querySelector('.ficha-section-body');
    sec.classList.add('fechada');body.style.maxHeight='0px';
    const title=sec.querySelector('.ficha-section-title');
    if(!title.dataset.accordionBound){
      title.addEventListener('click',()=>{
        if(!modoEdicao) return;
        const fechada=sec.classList.toggle('fechada');
        body.style.maxHeight=fechada?'0px':body.scrollHeight+'px';
      });
      title.dataset.accordionBound='1';
    }
  });
}
function abrirSecoes(){
  document.querySelectorAll('.ficha-section').forEach(sec=>{
    sec.classList.remove('fechada');
    sec.querySelector('.ficha-section-body').style.maxHeight='';
  });
}

// ─── Init ─────────────────────────────────────────────
async function init(){
  if(!npcSlug){
    document.getElementById('loading-overlay').innerHTML='<div style="padding:40px;color:#c00;font-size:14px">Não encontrei esse NPC.</div>';
    return;
  }
  try{
    const res=await apiGet('npcs',`slug=eq.${npcSlug}`);
    if(!res||!res[0]){
      document.getElementById('loading-overlay').innerHTML=`<div style="padding:40px;color:#c00;font-size:14px;text-align:center">Não encontrei "<strong>${npcSlug}</strong>" no NPCdex.<br><br><a href="/npcdex" style="color:#2563a8">← Voltar ao NPCdex</a></div>`;
      return;
    }
    npc=res[0];
    ['time','relacionamentos'].forEach(k=>{
      if(typeof npc[k]==='string'){try{npc[k]=JSON.parse(npc[k]);}catch{npc[k]=k==='time'?[{},{},{},{},{},{}]:[];}}
      if(!npc[k]) npc[k]=k==='time'?[{},{},{},{},{},{}]:[];
    });
    npc.rel_total=parseInt(npc.rel_total)||6;
    if(typeof npc.cores==='string'){try{npc.cores=JSON.parse(npc.cores);}catch{npc.cores=null;}}
    aplicarCoresFicha(npc.cores||CORES_DEFAULT);
    renderFicha();
    document.getElementById('loading-overlay').style.display='none';
    document.getElementById('top-bar').style.display='flex';
    document.getElementById('ficha-wrap').style.display='block';
    atualizarTopBar();
  }catch(e){
    console.error('Erro no init:',e);
    document.getElementById('loading-overlay').innerHTML=`<div style="padding:40px;color:#c00;font-size:13px;max-width:400px;text-align:center">❌ Erro ao carregar a ficha:<br><code style="font-size:11px">${e.message}</code><br><br><button onclick="location.reload()" style="margin-top:12px;padding:8px 20px;border-radius:6px;border:none;background:#2563a8;color:#fff;cursor:pointer">Tentar novamente</button></div>`;
  }
}
init();
</script>

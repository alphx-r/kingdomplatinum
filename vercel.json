{
  "trailingSlash": false,
  "redirects": [
    { "source": "/nationaldex.html", "destination": "/nationaldex", "permanent": true }
  ],
  "rewrites": [
    { "source": "/datadex",                    "destination": "/datadex/datadex.html"              },
    { "source": "/datadex/adm",                "destination": "/datadex/datadex_adm.html"          },
    { "source": "/datadex/nationaldex/:slug*", "destination": "/nationaldex/nationaldex.html"      },
    { "source": "/nationaldex/adm",            "destination": "/nationaldex/nationaldex_adm.html"  },
    { "source": "/nationaldex/:slug*",         "destination": "/nationaldex/nationaldex.html"      },

    { "source": "/datadex/movedex",            "destination": "/movedex/movedex.html"              },
    { "source": "/datadex/movedex/adm",        "destination": "/movedex/movedex_adm.html"          },

    { "source": "/datadex/abilitydex",         "destination": "/abilitydex/abilitydex.html"        },
    { "source": "/datadex/abilitydex/adm",     "destination": "/abilitydex/abilitydex_adm.html"    },

    { "source": "/datadex/itemdex",            "destination": "/itemdex/itemdex.html"              },
    { "source": "/datadex/itemdex/adm",        "destination": "/itemdex/itemdex_adm.html"          },

    { "source": "/weathercast",                "destination": "/weathercast/weathercast.html"      },
    { "source": "/weathercast/adm",            "destination": "/weathercast/weathercast_adm.html"  },

    { "source": "/npcdex",                     "destination": "/npcdex/npcdex.html"                },
    { "source": "/npcdex/adm",                 "destination": "/npcdex/npcdex_adm.html"            },
    { "source": "/npcdex/:slug*",              "destination": "/npcdex/npc_ficha.html"             },

    { "source": "/mapa",                       "destination": "/mapa.html"                         },
    { "source": "/pokemon.json",               "destination": "/pokemon.json"                      },
    { "source": "/api/cron/backup-pokemon",    "destination": "/api/cron/backup-pokemon"           },
    { "source": "/(.*)",                       "destination": "/index.html"                        }
  ],
  "headers": [
    {
      "source": "/pokemon.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/backup-pokemon", "schedule": "0 9 * * *" }
  ]
}
